datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  password   String
  first_name String
  last_name  String
  phone      String?
  age        Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model Workspace {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  visibility  Visibility @default(PRIVATE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  boards           Board[]
}

model WorkspaceMember {
  id Int @id @default(autoincrement())

  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      Int
  workspaceId Int
}

model Board {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  background  String?    @default("#fff")
  visibility  Visibility @default(PRIVATE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId Int

  lists List[]
}

model List {
  id         Int     @id @default(autoincrement())
  title      String
  position   Int
  background String? @default("#fff")

  board   Board @relation(fields: [boardId], references: [id])
  boardId Int

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  cards Card[]
}

model Card {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  position    Int
  background  String? @default("#fff")
  start_time   DateTime?
  due_time     DateTime?

  list   List @relation(fields: [listId], references: [id])
  listId Int

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}
